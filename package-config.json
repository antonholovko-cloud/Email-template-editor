{
  "name": "ngx-wysiwyg-editor",
  "displayName": "NGX WYSIWYG Editor",
  "description": "Drag-and-drop email template editor for Angular — block-based visual builder with responsive preview, dark theme, autosave, and clean HTML export",
  "author": {
    "name": "Anton Holovko",
    "email": "anton.holovko@gmail.com"
  },
  "copyright": "Copyright © 2026",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonholovko-cloud/Email-template-editor.git"
  },
  "projectUrl": "https://github.com/antonholovko-cloud/Email-template-editor",
  "iconUrl": "https://raw.githubusercontent.com/antonholovko-cloud/Email-template-editor/main/icon.png",
  "keywords": [
    "angular",
    "email",
    "email-template",
    "email-builder",
    "email-editor",
    "template-editor",
    "drag-and-drop",
    "wysiwyg",
    "editor",
    "html",
    "newsletter",
    "typescript"
  ],
  "tags": "angular;email;email-template;email-builder;drag-and-drop;wysiwyg;editor;html;newsletter;typescript",
  "releaseNotes": "Email template editor with block-based builder, template gallery, dark theme, and autosave",
  "nuget": {
    "packageId": "NgxWysiwygEditor",
    "targetFramework": ".NETStandard2.0",
    "outputDirectory": "./dist/nuget",
    "contentTargetFolder": "content\\wwwroot\\lib\\ngx-wysiwyg-editor"
  },
  "npm": {
    "publishConfig": {
      "registry": "https://registry.npmjs.org/",
      "access": "public"
    }
  },
  "build": {
    "outputPath": "dist/ngx-wysiwyg-editor",
    "configuration": "production"
  }
}
